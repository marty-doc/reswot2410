<shellsPrice.xml>
  <default-scene>DefaultScene</default-scene>
  <initial-scene>Hangar</initial-scene>
  <scenes>
    <scene>
      <post-effects></post-effects>
      <runtime-effects>
        <show-hint>
          <condition>
            <active>AmmunitionPanelOnScene</active>
          </condition>
        </show-hint>
      </runtime-effects>
      <gui-items>
        <gui-item>
          <on-scene-effects>
            <activate>AmmunitionPanelOnScene</activate>
          </on-scene-effects>
          <not-on-scene-effects>
            <inactivate>AmmunitionPanelOnScene</inactivate>
          </not-on-scene-effects>
        </gui-item>
      </gui-items>
    </scene>
    <scene>
      <post-effects>
        <refuse-training></refuse-training>
      </post-effects>
      <runtime-effects></runtime-effects>
      <gui-items></gui-items>
    </scene>
  </scenes>
  <has-id>
    <hint>
      <item-id>HangarPanelShells</item-id>
      <text>#quests:action/chain/hint/shellsPrice</text>
      <arrow>
        <direction>T</direction>
        <loop>True</loop>
      </arrow>
      <padding>
        <left>0</left>
        <top>0</top>
        <right>0</right>
        <bottom>0</bottom>
      </padding>
      <actions>
        <click>
          <effects>
            <refuse-training></refuse-training>
          </effects>
        </click>
        <click-outside>
          <effects>
            <refuse-training></refuse-training>
          </effects>
        </click-outside>
        <esc>
          <effects>
            <refuse-training></refuse-training>
          </effects>
        </esc>
      </actions>
      <hide-immediately>True</hide-immediately>
    </hint>
  </has-id>
  <triggers></triggers>
  <vars></vars>
</shellsPrice.xml>
