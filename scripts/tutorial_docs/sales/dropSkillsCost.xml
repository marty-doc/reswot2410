<dropSkillsCost.xml>
  <default-scene>DefaultScene</default-scene>
  <initial-scene>Hangar</initial-scene>
  <scenes>
    <scene>
      <post-effects>
        <inactivate>PersonalCaseDropSkillsButtonOnScene</inactivate>
      </post-effects>
      <runtime-effects>
        <show-hint>
          <condition>
            <effect-not-triggered>CrewHint</effect-not-triggered>
            <active>CrewPanelOnScene</active>
          </condition>
        </show-hint>
        <show-hint>
          <condition>
            <active>PersonalCaseDropSkillsButtonOnScene</active>
          </condition>
        </show-hint>
      </runtime-effects>
      <gui-items>
        <gui-item>
          <on-scene-effects>
            <activate>CrewPanelOnScene</activate>
          </on-scene-effects>
          <not-on-scene-effects>
            <refuse-training>
              <condition>
                <effect-triggered>CrewPanelOnScene</effect-triggered>
              </condition>
            </refuse-training>
            <inactivate>CrewPanelOnScene</inactivate>
          </not-on-scene-effects>
        </gui-item>
        <gui-item>
          <on-scene-effects>
            <activate>PersonalCaseDropSkillsButtonOnScene</activate>
          </on-scene-effects>
          <not-on-scene-effects>
            <inactivate>PersonalCaseDropSkillsButtonOnScene</inactivate>
          </not-on-scene-effects>
        </gui-item>
      </gui-items>
    </scene>
    <scene>
      <post-effects>
        <refuse-training></refuse-training>
      </post-effects>
      <runtime-effects></runtime-effects>
      <gui-items></gui-items>
    </scene>
  </scenes>
  <has-id>
    <hint>
      <item-id>CrewPanel</item-id>
      <text>#quests:action/chain/hint/openPersonalCase</text>
      <arrow>
        <direction>R</direction>
        <loop>True</loop>
      </arrow>
      <padding>
        <left>0</left>
        <top>0</top>
        <right>0</right>
        <bottom>0</bottom>
      </padding>
      <actions>
        <click>
          <effects>
            <run-trigger>PersonalCaseWaitTimer</run-trigger>
            <close-hint>CrewHint</close-hint>
          </effects>
        </click>
        <click-outside>
          <effects>
            <refuse-training></refuse-training>
          </effects>
        </click-outside>
        <esc>
          <effects>
            <refuse-training></refuse-training>
          </effects>
        </esc>
      </actions>
    </hint>
    <hint>
      <item-id>PersonalCaseDropSkillsButton</item-id>
      <text>#quests:action/chain/hint/dropSkills</text>
      <arrow>
        <direction>L</direction>
        <loop>True</loop>
      </arrow>
      <padding>
        <left>0</left>
        <top>0</top>
        <right>0</right>
        <bottom>0</bottom>
      </padding>
      <actions>
        <click>
          <effects>
            <refuse-training></refuse-training>
          </effects>
        </click>
        <click-outside>
          <effects>
            <refuse-training></refuse-training>
          </effects>
        </click-outside>
        <esc>
          <effects>
            <refuse-training></refuse-training>
          </effects>
        </esc>
      </actions>
    </hint>
  </has-id>
  <triggers>
    <trigger>
      <type>timer</type>
      <validate-var>WaitTimer</validate-var>
      <on-effects>
        <refuse-training>
          <condition>
            <inactive>PersonalCaseDropSkillsButtonOnScene</inactive>
          </condition>
        </refuse-training>
      </on-effects>
    </trigger>
  </triggers>
  <vars>
    <var-set>
      <asInt>5</asInt>
    </var-set>
  </vars>
</dropSkillsCost.xml>
