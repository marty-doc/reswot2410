<c11nPrice.xml>
  <default-scene>DefaultScene</default-scene>
  <initial-scene>Hangar</initial-scene>
  <scenes>
    <scene>
      <post-effects></post-effects>
      <runtime-effects>
        <show-hint>
          <condition>
            <active>TuningBtnOnScene</active>
          </condition>
        </show-hint>
        <refuse-training>
          <condition>
            <effect-triggered>CustomizationGroupHint</effect-triggered>
          </condition>
        </refuse-training>
      </runtime-effects>
      <gui-items>
        <gui-item>
          <on-scene-effects>
            <activate>TuningBtnOnScene</activate>
          </on-scene-effects>
          <not-on-scene-effects>
            <inactivate>TuningBtnOnScene</inactivate>
          </not-on-scene-effects>
        </gui-item>
      </gui-items>
    </scene>
    <scene>
      <post-effects>
        <refuse-training></refuse-training>
      </post-effects>
      <runtime-effects></runtime-effects>
      <gui-items></gui-items>
    </scene>
  </scenes>
  <has-id>
    <hint>
      <item-id>TuningBtn</item-id>
      <text>#quests:action/chain/hint/customization</text>
      <arrow>
        <direction>T</direction>
        <loop>True</loop>
      </arrow>
      <padding>
        <left>-5</left>
        <top>-5</top>
        <right>-3</right>
        <bottom>-3</bottom>
      </padding>
      <actions>
        <click>
          <effects>
            <activate>TuningBtnClicked</activate>
          </effects>
        </click>
        <click-outside>
          <effects>
            <refuse-training></refuse-training>
          </effects>
        </click-outside>
        <esc>
          <effects>
            <refuse-training></refuse-training>
          </effects>
        </esc>
      </actions>
    </hint>
  </has-id>
  <triggers></triggers>
  <vars></vars>
</c11nPrice.xml>
